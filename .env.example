# aLcassa · environment
#
# 04 ADR-008. Application environment variables hold only what Vercel must have
# at boot. Tenant API credentials are hashed and never stored recoverably;
# platform secrets that must be decryptable live in Supabase Vault.
#
# Copy to .env.local and fill in. Nothing here has a working default, because a
# working default is how a developer ships against the wrong database.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 06 §7. Server side only, never exposed to the browser, importable only from
# src/modules/platform. Four operations use it and every one writes an audit row
# before it runs. If you find yourself wanting it anywhere else, use support mode.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Auth (OAuth) ─────────────────────────────────────────────────────
# Provider provisioning inputs. Keep both private; never use NEXT_PUBLIC for the secret.
# Hosted Supabase: copy these values into Authentication > Sign In / Providers >
# Google and enable it. Next.js does not configure the hosted provider from these vars.
# Local Supabase: reference them from [auth.external.google] in config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# Google Cloud web OAuth client: authorize the Supabase callback, NOT the app callback:
#   hosted: https://<project-ref>.supabase.co/auth/v1/callback
#   disposable local stack: http://127.0.0.1:55421/auth/v1/callback
# Supabase Authentication > URL Configuration: set Site URL to NEXT_PUBLIC_APP_URL;
# allow the application's /api/v1/auth/callback redirect (including next query).
# Local verification: http://localhost:3100/api/v1/auth/callback** and
# http://127.0.0.1:3100/api/v1/auth/callback**. Use exact deployed origins when hosted.
# Add the Google consent screen test accounts while the OAuth app is in Testing.
# Setup and first-time/returning-account acceptance: verification/google-auth/README.md.

# ─── Database ────────────────────────────────────────────────────────────────
# The RLS-bound connection. ADR-004: this is NOT the service role. Drizzle
# connects as an ordinary role so every policy applies to its queries.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The privileged connection, used by migrations, the policy check script and the
# isolation suite only. Never imported by application code.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Cache ───────────────────────────────────────────────────────────────────
# 08 §6. Four uses, never a source of truth. Leave both blank to run without a
# cache: every read falls through to Postgres and every correctness property
# still holds. Only speed changes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Tenant API admission: configure identically in Node and Python deployments.
# One anchored window per stored tenant; platform/support visits are excluded.
SERVICE_RATE_LIMIT=120
SERVICE_RATE_WINDOW_SECONDS=60

# Forces every cache read to miss and every write to no-op. The CI job in
# 08 §6 runs the entire suite with this set.
CACHE_DISABLED=false

# ─── Observability ───────────────────────────────────────────────────────────
# 04 §8. Switched on in week 2, not during hardening.
# ── Error tracking · 04 §12 ────────────────────────────────────────────────
# Leave both empty and Sentry does not initialise at all — no global handlers,
# no patched fetch, no behaviour change. That is the intended local default.
#
# Events are scrubbed before they leave the process (src/lib/observability/
# sentry.ts): request bodies through the same redact() the logger uses, headers
# dropped except the correlation id, query strings replaced because reset and
# invitation tokens travel in them, and the user object reduced to an opaque id.
# Session replay is deliberately not enabled — it would record a customer's
# workspace and ship it to a third party.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_DATASET=
AXIOM_TOKEN=

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# production | staging | preview | development.
# 03 §8: anything other than production draws the boundary frame in slate
# reading STAGING. This is the only other context in which the frame appears.
NEXT_PUBLIC_ENVIRONMENT=development

# Cookie names. 02 §3 requires the two doors to hold genuinely separate sessions.
SESSION_COOKIE_TENANT=aLcassa_tenant_session
SESSION_COOKIE_PLATFORM=aLcassa_platform_session

# ── Review access · OFF unless this says exactly `true` ─────────────────────
# `/api/demo` hands out a session cookie WITHOUT AUTHENTICATING ANYONE, so the
# console and the workspace could be walked through before real accounts
# existed. `pnpm db:seed` now creates an account that can actually sign in, so
# the bypass has stopped buying anything and kept all of its cost.
#
# It no longer defaults on in development. The cookie it sets is a literal
# string rather than a session id, which gets a reader past the middleware and
# then resolves to nothing — the console renders designed data as though it
# were their account. See 19 §10 and src/lib/auth/demoAccess.ts.
#
# MUST NOT be set where real customer data lives.
ALLOW_DEMO_ACCESS=

# ── Seeding · `pnpm db:seed` ────────────────────────────────────────────────
# The demonstration operator's credentials. Both have defaults in the seed
# (brian@alcassa.co.ke), which is safe only because the seed refuses to run
# under NODE_ENV=production without SEED_ALLOW_PRODUCTION=1. Override either to
# seed a local instance whose password is not written down in the repository.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Transactional email · 10 §14 ────────────────────────────────────────────
# Both are required together. With either missing, the application selects the
# logging adapter: it reports `delivered: false` honestly and the interface
# hands the owner the invitation link to pass on themselves, rather than
# claiming an email was sent that never was. See src/modules/email/.
#
# EMAIL_FROM must be on a domain verified with the provider, or every send
# fails with a 422 that names exactly that. Verifying a domain means adding
# DNS records for it and waiting for them to propagate, so it is not something
# to discover on the day — run `pnpm check:email`, which asks the provider
# which domains it will actually accept and compares the answer to EMAIL_FROM.
#
# `onboarding@resend.dev` needs no verification and delivers ONLY to the
# Resend account owner's own address. Useful for proving the path end to end
# before DNS is in place; useless for anybody else.
RESEND_API_KEY=
EMAIL_FROM=aLcassa <support@alcassa.co.ke>

# ── Scheduled work · 08 §3 · 04 ADR-007 ────────────────────────────────────
# A cron has no user, so the nightly reconciliation route authenticates with a
# shared secret instead. Vercel sends it as `Authorization: Bearer $CRON_SECRET`
# on scheduled invocations.
#
# With this unset the route answers 404 — closed rather than open. An
# unconfigured cron endpoint that answered would be an unauthenticated report
# on every workspace's usage.
CRON_SECRET=

# Optional external scheduler: one `pnpm monitor:dependencies` invocation per minute.
# Set explicit health/readiness URLs; plain HTTP is allowed only on loopback.
# The state file must live on durable storage shared by successive invocations.
# Webhook consumers deduplicate the Idempotency-Key; keep its token server-side.
# This does not provision a scheduler or external paging account automatically.
MONITOR_APPLICATION_URL=
MONITOR_SERVICE_URL=
MONITOR_IDENTITY_URL=
MONITOR_STATE_FILE=
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_TOKEN=
