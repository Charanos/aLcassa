# aLcassa · environment
#
# 04 ADR-008. Application environment variables hold only what Vercel must have
# at boot. Tenant API credentials are hashed and never stored recoverably;
# platform secrets that must be decryptable live in Supabase Vault.
#
# Copy to .env.local and fill in. Nothing here has a working default, because a
# working default is how a developer ships against the wrong database.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 06 §7. Server side only, never exposed to the browser, importable only from
# src/modules/platform. Four operations use it and every one writes an audit row
# before it runs. If you find yourself wanting it anywhere else, use support mode.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database ────────────────────────────────────────────────────────────────
# The RLS-bound connection. ADR-004: this is NOT the service role. Drizzle
# connects as an ordinary role so every policy applies to its queries.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The privileged connection, used by migrations, the policy check script and the
# isolation suite only. Never imported by application code.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Cache ───────────────────────────────────────────────────────────────────
# 08 §6. Four uses, never a source of truth. Leave both blank to run without a
# cache: every read falls through to Postgres and every correctness property
# still holds. Only speed changes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Forces every cache read to miss and every write to no-op. The CI job in
# 08 §6 runs the entire suite with this set.
CACHE_DISABLED=false

# ─── Observability ───────────────────────────────────────────────────────────
# 04 §8. Switched on in week 2, not during hardening.
# ── Error tracking · 04 §12 ────────────────────────────────────────────────
# Leave both empty and Sentry does not initialise at all — no global handlers,
# no patched fetch, no behaviour change. That is the intended local default.
#
# Events are scrubbed before they leave the process (src/lib/observability/
# sentry.ts): request bodies through the same redact() the logger uses, headers
# dropped except the correlation id, query strings replaced because reset and
# invitation tokens travel in them, and the user object reduced to an opaque id.
# Session replay is deliberately not enabled — it would record a customer's
# workspace and ship it to a third party.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_DATASET=
AXIOM_TOKEN=

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# production | staging | preview | development.
# 03 §8: anything other than production draws the boundary frame in slate
# reading STAGING. This is the only other context in which the frame appears.
NEXT_PUBLIC_ENVIRONMENT=development

# Cookie names. 02 §3 requires the two doors to hold genuinely separate sessions.
SESSION_COOKIE_TENANT=aLcassa_tenant_session
SESSION_COOKIE_PLATFORM=aLcassa_platform_session

# ── Review access ───────────────────────────────────────────────────────────
# `/api/demo` hands out a session cookie WITHOUT AUTHENTICATING ANYONE, so the
# console and the workspace can be walked through before real accounts exist.
# On by default in local development; anywhere else it must be opted into
# deliberately, per environment. MUST NOT be set where real customer data
# lives. See src/lib/auth/demoAccess.ts.
ALLOW_DEMO_ACCESS=

# ── Transactional email · 10 §14 ────────────────────────────────────────────
# Both are required together. With either missing, the application selects the
# logging adapter: it reports `delivered: false` honestly and the interface
# hands the owner the invitation link to pass on themselves, rather than
# claiming an email was sent that never was. See src/modules/email/.
#
# EMAIL_FROM must be on a domain verified with the provider, or every send
# fails with a 422 that names exactly that.
RESEND_API_KEY=
EMAIL_FROM=aLcassa <noreply@alcassa.app>
