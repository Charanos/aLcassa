  "paths": {
    "/service/v1/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health",
        "description": "Process liveness only; does not assert database or tenant readiness.",
        "operationId": "health_service_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/service/v1/ready": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Ready",
        "description": "Database-role and RLS readiness, independent of process liveness.",
