  "components": {
    "schemas": {
      "ErrorData": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorData"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorData"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthData": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "alcassa-service",
            "title": "Service",
            "default": "alcassa-service"
          }
        },
        "type": "object",
        "title": "HealthData"
      },
      "HealthResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "HealthResponse"
      },
      "ReadinessData": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "const": "ready",
            "title": "Database"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessData"
      },
      "ReadinessResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReadinessData"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ReadinessResponse"
      },
      "RulesData": {
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "title": "Tenantid"
          },
          "compiledAt": {
            "type": "string",
            "format": "date-time",
            "title": "Compiledat"
          },
          "masterVersion": {
            "type": "integer",
            "title": "Masterversion"
          },
          "tenantVersion": {
            "type": "integer",
            "title": "Tenantversion"
          },
          "rules": {
            "$ref": "#/components/schemas/RulesDocument"
          },
          "provenance": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "master",
                "tenant",
                "master+tenant"
              ]
            },
            "type": "object",
            "title": "Provenance"
          },
          "locked": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Locked"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenantId",
          "compiledAt",
          "masterVersion",
          "tenantVersion",
          "rules",
          "provenance",
          "locked"
        ],
        "title": "RulesData"
      },
      "RulesDocument": {
        "properties": {
          "tone": {
            "type": "string",
            "title": "Tone"
          },
          "responseGuidelines": {
            "type": "string",
            "title": "Responseguidelines"
          },
          "businessInformation": {
            "type": "string",
            "title": "Businessinformation"
          },
          "escalationInstructions": {
            "type": "string",
            "title": "Escalationinstructions"
          },
          "prohibitedTopics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prohibitedtopics"
          },
          "customInstructions": {
            "type": "string",
            "title": "Custominstructions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RulesDocument"
      },
      "RulesResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RulesData"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "RulesResponse"
      },
      "TenantData": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "locale": {
            "type": "string",
            "title": "Locale"
          },
          "status": {
            "type": "string",
            "enum": [
              "trial",
              "active",
              "past_due"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "timezone",
          "locale",
          "status"
        ],
        "title": "TenantData"
      },
      "TenantResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TenantData"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "TenantResponse"
      },
      "SessionRules": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "master": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "versionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "content": {
                    "type": "object",
                    "properties": {
                      "tone": {
                        "type": "string"
                      },
                      "responseGuidelines": {
                        "type": "string"
                      },
                      "businessInformation": {
                        "type": "string"
                      },
                      "escalationInstructions": {
                        "type": "string"
                      },
                      "prohibitedTopics": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "customInstructions": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "lockedFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "versionNumber": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "id",
                  "updatedAt",
                  "versionId",
                  "content",
                  "lockedFields",
                  "versionNumber"
                ],
                "additionalProperties": false
              },
              "current": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "versionNumber": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "tone": {
                            "type": "string"
                          },
                          "responseGuidelines": {
                            "type": "string"
                          },
                          "businessInformation": {
                            "type": "string"
                          },
                          "escalationInstructions": {
                            "type": "string"
                          },
                          "prohibitedTopics": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "customInstructions": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      },
                      "publishedAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "versionNumber",
                      "content",
                      "publishedAt"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "revision": {
                "type": "object",
                "properties": {
                  "currentVersionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "updatedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "masterVersionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "masterUpdatedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "currentVersionId",
                  "updatedAt",
                  "masterVersionId",
                  "masterUpdatedAt"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "master",
              "current",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "RulePublication": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "properties": {
              "tone": {
                "type": "string",
                "maxLength": 1000
              },
              "responseGuidelines": {
                "type": "string",
                "maxLength": 10000
              },
              "businessInformation": {
                "type": "string",
                "maxLength": 10000
              },
              "escalationInstructions": {
                "type": "string",
                "maxLength": 10000
              },
              "prohibitedTopics": {
                "type": "string",
                "maxLength": 10000
              },
              "customInstructions": {
                "type": "string",
                "maxLength": 10000
              }
            },
            "required": [
              "tone",
              "responseGuidelines",
              "businessInformation",
              "escalationInstructions",
              "prohibitedTopics",
              "customInstructions"
