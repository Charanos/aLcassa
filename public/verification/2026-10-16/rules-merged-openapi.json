            "additionalProperties": false
          },
          "revision": {
            "type": "object",
            "properties": {
              "currentVersionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "updatedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "masterVersionId": {
                "type": "string",
                "format": "uuid"
              },
              "masterUpdatedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "currentVersionId",
              "updatedAt",
              "masterVersionId",
              "masterUpdatedAt"
            ],
            "additionalProperties": false
          },
          "changeNote": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          }
        },
        "required": [
          "fields",
          "revision",
          "changeNote"
        ],
        "additionalProperties": false
      },
      "RuleRestoration": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "object",
