              "currentVersionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "updatedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "masterVersionId": {
                "type": "string",
                "format": "uuid"
              },
              "masterUpdatedAt": {
                "type": "string",
                "format": "date-time"
