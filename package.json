{
  "name": "aLcassa",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant customer support platform, Phase 1 foundation. Andishi for Brian.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:extensions && drizzle-kit migrate && tsx scripts/apply-policies.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "reconcile:usage": "tsx scripts/reconcile-usage.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "check:policies": "tsx scripts/check-policies.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run tests/isolation",
    "test:cache-disabled": "cross-env CACHE_DISABLED=true vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:deps && pnpm check:policies && pnpm test",
    "db:policies": "tsx scripts/apply-policies.ts",
    "check:deps": "tsx scripts/check-phantom-deps.ts",
    "db:extensions": "tsx scripts/create-extensions.ts",
    "db:app-role": "tsx scripts/create-app-role.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/libertinus-math": "^5.2.5",
    "@fontsource/libertinus-mono": "^5.2.5",
    "@fontsource/libertinus-sans": "^5.2.5",
    "@fontsource/libertinus-serif": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^9.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tabler/icons-react": "^3.46.0",
    "@upstash/redis": "^1.34.5",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lightningcss": "^1.33.0",
    "next": "^15.5.22",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.5.22",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "esbuild": ">=0.25.0"
    }
  }
}
