{
  "name": "aLcassa",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant customer support platform, Phase 1 foundation. Andishi for Brian.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:extensions && drizzle-kit migrate && tsx scripts/apply-policies.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "reconcile:usage": "tsx scripts/reconcile-usage.ts",
    "monitor:dependencies": "tsx scripts/monitor-dependencies.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "check:policies": "tsx scripts/check-policies.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run tests/isolation",
    "test:cache-disabled": "cross-env CACHE_DISABLED=true vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:deps && pnpm check:policies && pnpm test",
    "db:policies": "tsx scripts/apply-policies.ts",
    "check:deps": "tsx scripts/check-phantom-deps.ts",
    "check:security": "tsx scripts/check-security.ts",
    "db:extensions": "tsx scripts/create-extensions.ts",
    "db:app-role": "tsx scripts/create-app-role.ts",
    "db:check-admin": "tsx scripts/check-admin-account.ts",
    "db:check-provisioning": "tsx scripts/check-provisioning.ts",
    "db:check-provision-write": "tsx scripts/check-provision-write.ts",
    "db:check-break-glass": "tsx scripts/check-break-glass.ts",
    "check:figures": "tsx scripts/check-console-figures.ts",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=.test-report/results.json",
    "test:prove": "tsx scripts/prove-tests.ts",
    "check:email": "tsx scripts/check-email.ts",
    "email:templates": "tsx scripts/auth-email-templates.ts",
    "check:email-templates": "tsx scripts/auth-email-templates.ts --check",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "shots": "tsx scripts/screenshot.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/libertinus-math": "^5.3.0",
    "@fontsource/libertinus-mono": "^5.3.0",
    "@fontsource/libertinus-sans": "^5.3.0",
    "@fontsource/libertinus-serif": "^5.3.0",
    "@fontsource/lilex": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sentry/nextjs": "^11.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tabler/icons-react": "^3.49.0",
    "@upstash/redis": "^1.39.0",
    "chart.js": "4.5.1",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "lightningcss": "^1.33.0",
    "next": "^15.5.27",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "playwright": "1.62.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1",
      "@opentelemetry/core": ">=2.8.0",
      "esbuild": ">=0.25.0"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  }
}
